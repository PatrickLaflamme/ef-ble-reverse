# /etc/ecoflow/rotator.env  (chown root:ecoflow, chmod 0640)
# Account user id (same value used by connect.py; both DPUs are bonded to it).
ECOFLOW_USER_ID=1234567890123456789

# BLE addresses of the two parallel DPU units.
ECOFLOW_ADDR_A=AA:BB:CC:DD:EE:01
ECOFLOW_ADDR_B=AA:BB:CC:DD:EE:02

# Portal bind (nginx proxies ecoflow-controller.local -> here). Keep on
# localhost so the portal is only reachable via nginx.
ECOFLOW_HTTP_HOST=127.0.0.1
ECOFLOW_HTTP_PORT=8787
