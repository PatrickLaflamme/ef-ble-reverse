# /etc/ecoflow/rotator.env  (chown root:ecoflow, chmod 0640)
# Account user id (same value used by connect.py; both DPUs are bonded to it).
ECOFLOW_USER_ID=1234567890123456789

# BLE addresses of the two parallel DPU units.
ECOFLOW_ADDR_A=AA:BB:CC:DD:EE:01
ECOFLOW_ADDR_B=AA:BB:CC:DD:EE:02

# Portal bind (nginx proxies ecoflow-controller.local -> here). Keep on
# localhost so the portal is only reachable via nginx.
ECOFLOW_HTTP_HOST=127.0.0.1
ECOFLOW_HTTP_PORT=8787

# Verbose BLE logging: per-heartbeat protobuf dumps + per-packet hex. Off by
# default (they firehose the journal ~60 lines/heartbeat/unit and bury
# lifecycle/error lines). Set to 1 only for protocol debugging.
#EF_BLE_DEBUG=1

# --- Better Stack: paging (heartbeat dead-man's switch) -----------------------
# One Better Stack *Heartbeat* monitor per unit. While a unit's BLE link is
# fresh the controller pings its URL; if the link goes stale the pings stop and
# Better Stack pages you, naming that unit. Map A/B to the SAME order as
# ECOFLOW_ADDR_A/B above. Set each heartbeat to ~30s period + ~30s grace so it
# alerts at ~60s of BT silence ("down > 1m"). Optional CONTROLLER heartbeat is
# pinged every tick regardless, to catch the controller process dying.
#BETTERSTACK_HEARTBEAT_A=https://uptime.betterstack.com/api/v1/heartbeat/xxxxA
#BETTERSTACK_HEARTBEAT_B=https://uptime.betterstack.com/api/v1/heartbeat/xxxxB
#BETTERSTACK_HEARTBEAT_CONTROLLER=https://uptime.betterstack.com/api/v1/heartbeat/xxxxC
#WATCHDOG_TICK_S=15        # how often the watchdog pings (default 15)
#HEARTBEAT_FRESH_S=30      # unit considered healthy if last heartbeat < this (default 30)

# --- Better Stack: metrics (Telemetry source) ---------------------------------
# Push SoC / in-out-solar-grid watts / RSSI / drop events to a Better Stack
# Telemetry source (same data also goes to the local SQLite db). Create a source
# in Better Stack -> Telemetry; use its ingest URL + token. Disabled if unset.
#BETTERSTACK_SOURCE_URL=https://<your-source>.betterstackdata.com
#BETTERSTACK_SOURCE_TOKEN=xxxxxxxxxxxxxxxx
#BETTERSTACK_METRICS_INTERVAL_S=60   # per-unit sample cadence (default 60)
